#!/usr/bin/env python3
"""sky-kbd — Windows-style keyboard layout switching + layout OSD + key sounds,
ported from whitebook's osd-daemon for KDE Plasma on Wayland.

    Alt+Shift    EN <-> RU   (from UA: back to EN)
    Ctrl+Shift   UA          (pressed again on UA: back to the previous layout)

The chord fires on key RELEASE and only if nothing else was pressed while the
modifiers were held, so Ctrl+Shift+V, Alt+Shift+Tab and the like keep working.
Keys are read from evdev (/dev/input, the user must be in the `input` group);
nothing is grabbed. The layout is switched through KDE's own D-Bus service
(org.kde.keyboard /Layouts) and shown with Plasma's OSD (osdService), so the
tray indicator and the OSD are the native ones. Plasma's own xkb toggle option
(grp:alt_shift_toggle) must be off, or both will fire — apply.sh removes it.

Sounds: Enter -> accept.wav, arrows -> move.wav (Diablo menu sounds); disabled by
`touch ~/.config/sky-kbd/nosound`.  Run as a `systemd --user` service.
"""
import ctypes
import os
import selectors
import threading
import time
import wave

import evdev
from evdev import ecodes as E
from gi.repository import Gio, GLib

NOSOUND = os.path.expanduser("~/.config/sky-kbd/nosound")
SOUND_DIR = os.path.expanduser("~/.local/share/sky-kbd")
MODS = {E.KEY_LEFTSHIFT: "shift", E.KEY_RIGHTSHIFT: "shift",
        E.KEY_LEFTCTRL: "ctrl", E.KEY_RIGHTCTRL: "ctrl",
        E.KEY_LEFTALT: "alt", E.KEY_RIGHTALT: "altgr",
        E.KEY_LEFTMETA: "super", E.KEY_RIGHTMETA: "super"}
ENTER = {E.KEY_ENTER, E.KEY_KPENTER}
ARROWS = {E.KEY_LEFT, E.KEY_RIGHT, E.KEY_UP, E.KEY_DOWN}
BUTTONS = {E.BTN_LEFT, E.BTN_RIGHT, E.BTN_MIDDLE, E.BTN_TOUCH}


# ---------------------------------------------------------------- KDE: layouts and OSD over D-Bus
class Kde:
    def __init__(self):
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.layouts = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, "org.kde.keyboard",
                                              "/Layouts", "org.kde.KeyboardLayouts", None)
        self.osd = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, "org.kde.plasmashell",
                                          "/org/kde/osdService", "org.kde.osdService", None)

    def names(self):
        """['EN', 'RU', 'UA'] in Plasma's layout order (short names upper-cased)."""
        out = []
        for entry in self.layouts.call_sync("getLayoutsList", None, 0, 2000, None).unpack()[0]:
            short = entry[0]
            out.append({"us": "EN", "gb": "EN"}.get(short, short.upper()))
        return out or ["EN"]

    def current(self):
        return self.layouts.call_sync("getLayout", None, 0, 2000, None).unpack()[0]

    def switch(self, index):
        self.layouts.call_sync("switchToLayout", GLib.Variant("(u)", (index,)), 0, 2000, None)

    def show(self, text):
        try:
            self.osd.call_sync("showText", GLib.Variant("(ss)", ("input-keyboard", text)), 0, 2000, None)
        except GLib.Error as e:
            print("sky-kbd: osd:", e, flush=True)


# ---------------------------------------------------------------- chords (verbatim from whitebook, tested there)
class Chords:
    def __init__(self, cats, held=lambda: None):
        self.cats = cats
        self.down = {}
        self.dirty = False
        self.held = held

    def press(self, kc):
        cat = self.cats.get(kc)
        if cat is None:
            self.dirty = True
            return
        real = self.held()
        if real is not None:
            for k in list(self.down):
                if k not in real:
                    del self.down[k]
        if not self.down:
            self.dirty = False
        self.down[kc] = cat

    def button(self):
        self.dirty = True

    def release(self, kc):
        combo = None
        if kc in self.down:
            held = set(self.down.values())
            if not self.dirty:
                if held == {"alt", "shift"}:
                    combo = "alt_shift"
                elif held == {"ctrl", "shift"}:
                    combo = "ctrl_shift"
                if combo:
                    self.dirty = True
            del self.down[kc]
        if not self.down:
            self.dirty = False
        return combo


# ---------------------------------------------------------------- sounds (libpulse-simple, works with PipeWire)
class Sounds:
    def __init__(self, files):
        self.pcm, self.rate, self.channels = {}, None, None
        for name, path in files.items():
            try:
                with wave.open(path, "rb") as w:
                    if self.rate is None:
                        self.rate, self.channels = w.getframerate(), w.getnchannels()
                    self.pcm[name] = w.readframes(w.getnframes())
            except (OSError, wave.Error) as e:
                print("sky-kbd: sound not loaded:", path, e, flush=True)
        self.pa = None
        self.lock = threading.Lock()
        self.running = False
        self.next = None

    def play(self, name):
        if name not in self.pcm or os.path.exists(NOSOUND):
            return
        with self.lock:
            self.next = name
            if not self.running:
                self.running = True
                threading.Thread(target=self._run, daemon=True).start()

    def _lib(self):
        if self.pa is None:
            lib = ctypes.CDLL("libpulse-simple.so.0")
            lib.pa_simple_new.restype = ctypes.c_void_p
            lib.pa_simple_new.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
                                          ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p,
                                          ctypes.c_void_p]
            lib.pa_simple_write.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
            lib.pa_simple_drain.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
            lib.pa_simple_flush.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
            lib.pa_simple_free.argtypes = [ctypes.c_void_p]
            self.pa = lib
        return self.pa

    def _run(self):
        try:
            lib = self._lib()

            class Spec(ctypes.Structure):
                _fields_ = [("format", ctypes.c_int), ("rate", ctypes.c_uint32), ("channels", ctypes.c_uint8)]

            class Attr(ctypes.Structure):
                _fields_ = [(n, ctypes.c_uint32) for n in ("maxlength", "tlength", "prebuf", "minreq", "fragsize")]
            spec = Spec(3, self.rate, self.channels)
            chunk = int(self.rate * self.channels * 2 * 0.04)
            attr = Attr(0xFFFFFFFF, chunk * 2, 0, 0xFFFFFFFF, 0xFFFFFFFF)
            err = ctypes.c_int(0)
            stream = lib.pa_simple_new(None, b"sky-kbd", 1, None, b"key", ctypes.byref(spec), None,
                                       ctypes.byref(attr), ctypes.byref(err))
            if not stream:
                return
            pcm, pos = b"", 0
            while True:
                with self.lock:
                    if self.next is not None:
                        pcm, pos = self.pcm[self.next], 0
                        self.next = None
                        lib.pa_simple_flush(stream, ctypes.byref(err))
                if pos >= len(pcm):
                    lib.pa_simple_drain(stream, ctypes.byref(err))
                    with self.lock:
                        if self.next is None:
                            self.running = False
                            break
                    continue
                lib.pa_simple_write(stream, pcm[pos:pos + chunk], min(chunk, len(pcm) - pos), ctypes.byref(err))
                pos += chunk
            lib.pa_simple_free(stream)
        except Exception as e:  # noqa: BLE001
            print("sky-kbd: sound failed:", e, flush=True)
        finally:
            with self.lock:
                self.running = False


# ---------------------------------------------------------------- layouts
class Layouts:
    def __init__(self, kde):
        self.kde = kde
        self.names = kde.names()
        self.current = kde.current()
        self.previous = 0
        self.changed_at = 0.0

    def idx(self, name):
        return self.names.index(name) if name in self.names else None

    def switch(self, g):
        if g is None or g == self.current:
            return
        if self.names[self.current] != "UA":
            self.previous = self.current
        self.changed_at = time.monotonic()
        self.kde.switch(g)
        self.current = g
        self.kde.show(self.names[g])

    def alt_shift(self):
        en, ru = self.idx("EN"), self.idx("RU")
        if self.names[self.current] == "EN" and ru is not None:
            self.switch(ru)
        else:
            self.switch(en if en is not None else 0)

    def ctrl_shift(self):
        ua = self.idx("UA")
        if ua is None:
            return
        self.switch(self.previous if self.current == ua else ua)

    def watch_external(self):
        """The tray widget or Plasma changed the layout (or the list): follow it."""
        while True:
            time.sleep(0.5)
            try:
                g = self.kde.current()
                names = self.kde.names()
            except GLib.Error:
                continue
            if names != self.names:
                self.names, self.current, self.previous = names, min(g, len(names) - 1), 0
                continue
            if g != self.current and time.monotonic() - self.changed_at > 0.8:
                if self.names[self.current] != "UA":
                    self.previous = self.current
                self.current = g


# ---------------------------------------------------------------- evdev
def keyboards():
    devs = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
            caps = d.capabilities().get(E.EV_KEY, [])
            if E.KEY_LEFTSHIFT in caps or E.BTN_LEFT in caps or E.BTN_TOUCH in caps:
                devs.append(d)
            else:
                d.close()
        except OSError:
            pass
    return devs


def watch_keys(layouts, sounds):
    while True:
        devs = keyboards()
        if not devs:
            time.sleep(3)
            continue
        sel = selectors.DefaultSelector()
        for d in devs:
            sel.register(d, selectors.EVENT_READ)

        def really_down():
            held = set()
            for d in devs:
                try:
                    held.update(d.active_keys())
                except OSError:
                    pass
            return held
        chords = Chords(MODS, really_down)
        keyed = ENTER | ARROWS
        started = time.monotonic()
        try:
            while True:
                for key, _ in sel.select(timeout=10):
                    for ev in key.fileobj.read():
                        if ev.type != E.EV_KEY:
                            continue
                        code, value = ev.code, ev.value          # 1 press, 0 release, 2 autorepeat
                        if code in BUTTONS:
                            if value == 1:
                                chords.button()
                            continue
                        if value == 1:
                            if code in keyed:
                                sounds.play("accept" if code in ENTER else "move")
                            chords.press(code)
                        elif value == 0:
                            combo = chords.release(code)
                            if combo == "alt_shift":
                                layouts.alt_shift()
                            elif combo == "ctrl_shift":
                                layouts.ctrl_shift()
                # a keyboard plugged in later (USB): rescan every minute
                if time.monotonic() - started > 60 and len(keyboards()) != len(devs):
                    break
        except OSError:
            pass
        finally:
            sel.close()
            for d in devs:
                try:
                    d.close()
                except OSError:
                    pass
        time.sleep(1)


def main():
    kde = None
    for _ in range(60):                     # Plasma may still be starting
        try:
            kde = Kde()
            kde.names()
            break
        except GLib.Error:
            time.sleep(2)
    if kde is None:
        raise SystemExit("sky-kbd: org.kde.keyboard is not on the session bus")
    sounds = Sounds({n: os.path.join(SOUND_DIR, f"{n}.wav") for n in ("accept", "move")})
    layouts = Layouts(kde)
    threading.Thread(target=layouts.watch_external, daemon=True).start()
    watch_keys(layouts, sounds)


if __name__ == "__main__":
    main()
