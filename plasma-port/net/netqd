#!/usr/bin/env python3
"""netqd — connection quality, ported from whitebook (no panel markup, no Xfce).

Two long-running pings, one per second: the router (default gateway) and the
internet (1.1.1.1). Every second it writes

    $XDG_RUNTIME_DIR/netq.txt    "23 · 25"   latency now · median over 10 s (internet)
                                 "offline"    no default route
                                 "…"          measuring
    $XDG_RUNTIME_DIR/netq.json   full state: verdict, internet, router, iface, traffic

`panel-ping` prints netq.txt for the Command Output panel widget; the JSON is for
a tooltip or a menu. Run as a `systemd --user` service (netqd.service).
"""
import json
import os
import statistics
import subprocess
import threading
import time
from collections import deque

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
OUT = os.path.join(RUN, "netq.txt")
STATE = os.path.join(RUN, "netq.json")
INTERNET = "1.1.1.1"
WINDOW = 10


def default_route():
    try:
        with open("/proc/net/route") as f:
            next(f)
            for line in f:
                p = line.split()
                if p[1] == "00000000" and int(p[3], 16) & 2:
                    gw = bytes.fromhex(p[2])[::-1]
                    return p[0], ".".join(str(b) for b in gw)
    except (OSError, StopIteration, ValueError):
        pass
    return None, None


class Pinger:
    def __init__(self):
        self.samples = deque()
        self.proc = None
        self.target = None
        self.lock = threading.Lock()

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def retarget(self, target, force=False):
        if target == self.target and not force:
            return
        self.stop()
        self.target = target
        with self.lock:
            self.samples.clear()
        if target:
            self.proc = subprocess.Popen(
                ["stdbuf", "-oL", "ping", "-n", "-O", "-i", "1", "-W", "1", target],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            threading.Thread(target=self._read, args=(self.proc,), daemon=True).start()

    def stop(self):
        if self.proc:
            self.proc.kill()
            self.proc = None

    def _read(self, proc):
        for line in proc.stdout:
            rtt = None
            if "time=" in line:
                try:
                    rtt = float(line.split("time=")[1].split()[0])
                except (IndexError, ValueError):
                    continue
            elif "no answer yet" not in line:
                continue
            with self.lock:
                self.samples.append((time.monotonic(), rtt))

    def summary(self):
        now = time.monotonic()
        with self.lock:
            while self.samples and now - self.samples[0][0] > WINDOW:
                self.samples.popleft()
            s = list(self.samples)
        if not s:
            return None
        ok = [r for _, r in s if r is not None]
        return {"now": s[-1][1], "median": statistics.median(ok) if ok else None,
                "loss": round(100 * (len(s) - len(ok)) / len(s)), "fresh": now - s[-1][0] < 3}


def counters(iface):
    try:
        with open("/proc/net/dev") as f:
            for line in f:
                name, _, rest = line.partition(":")
                if name.strip() == iface:
                    v = rest.split()
                    return int(v[0]), int(v[8])
    except OSError:
        pass
    return 0, 0


def fmt(ms):
    return "—" if ms is None else str(round(ms))


def write(path, text):
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def main():
    router, internet = Pinger(), Pinger()
    internet.retarget(INTERNET)
    iface = gw = None
    prev = None
    last_route_check = 0.0
    while True:
        t0 = time.monotonic()
        if t0 - last_route_check > 5:
            last_route_check = t0
            new_iface, new_gw = default_route()
            if new_gw != gw or (new_gw and not router.alive()):
                router.retarget(new_gw, force=True)
            if (new_iface is None) != (iface is None) or (new_iface and not internet.alive()):
                internet.retarget(INTERNET if new_iface else None, force=True)
            iface, gw = new_iface, new_gw

        r, i = router.summary(), internet.summary()
        down = up = 0.0
        if iface:
            rx, tx = counters(iface)
            if prev and prev[0] == iface:
                span = t0 - prev[1]
                down, up = max(0, (rx - prev[2]) / span), max(0, (tx - prev[3]) / span)
            prev = (iface, t0, rx, tx)

        if not iface:
            text, verdict = "offline", "No network connection"
        elif not i or not i["fresh"]:
            text, verdict = "…", "Measuring…"
        else:
            text = f"{fmt(i['now'])} · {fmt(i['median'])}"
            router_bad = r and (r["median"] is None or r["median"] > 40 or r["loss"] >= 10)
            net_bad = i["median"] is None or i["median"] > 100 or i["loss"] >= 5
            verdict = ("Slow: Wi-Fi / router" if router_bad else
                       "Slow: provider / internet" if net_bad else "Connection is fine")
        write(OUT, text + "\n")
        write(STATE, json.dumps({"verdict": verdict, "internet": i, "router": r, "gateway": gw,
                                 "iface": iface, "down": down, "up": up}))
        time.sleep(max(0.2, 1 - (time.monotonic() - t0)))


if __name__ == "__main__":
    main()
