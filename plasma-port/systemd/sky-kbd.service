[Unit]
Description=Windows-style keyboard layout switching, layout OSD and key sounds (Wayland, evdev + KDE D-Bus)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sky-kbd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
